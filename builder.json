{
  "project": "readapp",
  "platform": "ios",
  "github": {
    "owner": "Yhtiyar",
    "repo": "rdpp"
  },
  "provider": "github",
  "codemagic": {},
  "bitrise": {},
  "ios": {
    "path": "ios",
    "scheme": "Runner",
    "bundleId": "com.example.readapp",
    "extensions": [
      "com.example.readapp.ScreenTimeMonitor"
    ]
  },
  "profiles": {
    "release": {
      "configuration": "Release"
    },
    "preview-release": {
      "configuration": "Release",
      "env": {
        "LITTLEWINS_WITHOUT_SC": "1"
      }
    },
    "preview": {
      "configuration": "Debug",
      "env": {
        "LITTLEWINS_WITHOUT_SC": "1"
      }
    },
    "development": {
      "distribution": "development",
      "configuration": "Debug"
    }
  },
  "flutter": {
    "version": "3.47.5",
    "watch": {}
  },
  "reactNative": {},
  "kmp": {},
  "mobai": {}
}
